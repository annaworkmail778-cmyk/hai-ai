# Copy to .env.local for local development, or set these in your hosting
# provider's environment settings. Never commit real secrets.

# Public URL of the site, without a trailing slash. Used for canonical links,
# hreflang alternates, the sitemap, Open Graph images and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Contact form delivery ────────────────────────────────────────────────
# Configure at least one channel for production. Without any channel the
# form logs submissions in development and answers "not configured" in
# production (it never pretends a message was sent).

# Generic webhook: CRM, Make, n8n, Zapier or your own API (receives JSON).
CONTACT_WEBHOOK_URL=
# Optional, sent as "Authorization: Bearer <secret>".
CONTACT_WEBHOOK_SECRET=

# Telegram: create a bot with @BotFather, add it to the chat that should
# receive leads, then use that chat's id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend (https://resend.com). The sender must be on a verified domain.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
